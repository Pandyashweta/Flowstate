{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile, role, organization, and AI/notification preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["Admin", "Approver", "Operator", "Viewer"] },
        "department": { "type": "string", "maxLength": 80 },
        "organizationName": { "type": "string", "maxLength": 120 },
        "voiceLanguage": { "type": "string", "maxLength": 20 },
        "autoSpeakResponses": { "type": "boolean" },
        "requireApprovalForExternal": { "type": "boolean" },
        "notifyApprovals": { "type": "boolean" },
        "notifyFailures": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "department", "organizationName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private PII isolated under users/{userId}/private/{docId}.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt", "updatedAt"]
    },
    "Workflow": {
      "title": "Workflow",
      "description": "Structured enterprise workflow generated by voice/AI or created manually.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "category": { "type": "string", "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": ["draft", "awaiting_approval", "approved", "in_progress", "blocked", "completed", "failed"]
        },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "recommendedTeam": { "type": "string", "maxLength": 120 },
        "triggerType": { "type": "string", "enum": ["voice", "chat", "manual", "scheduled", "webhook"] },
        "sourcePrompt": { "type": "string", "maxLength": 2000 },
        "troubleshootingSummary": { "type": "string", "maxLength": 5000 },
        "durationMs": { "type": "number" },
        "steps": { "type": "array" },
        "ragSources": { "type": "array" },
        "dueDate": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "code", "title", "description", "category", "status", "priority", "recommendedTeam", "triggerType", "durationMs", "steps", "ragSources", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Actionable task belonging to a workflow with dependencies, comments, and owner.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "workflowId": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "assignee": { "type": "string", "maxLength": 120 },
        "department": { "type": "string", "maxLength": 80 },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["backlog", "todo", "in_progress", "blocked", "completed"] },
        "dueDate": { "type": "string", "maxLength": 40 },
        "dependencies": { "type": "array" },
        "comments": { "type": "array" },
        "integrationAction": { "type": "string", "maxLength": 200 },
        "requiresApproval": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "workflowId", "code", "title", "description", "assignee", "department", "priority", "status", "dueDate", "dependencies", "comments", "requiresApproval", "createdAt", "updatedAt"]
    },
    "KnowledgeDoc": {
      "title": "KnowledgeDoc",
      "description": "Uploaded enterprise document for RAG retrieval and grounded Q&A.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "fileName": { "type": "string", "maxLength": 200 },
        "fileType": { "type": "string", "enum": ["pdf", "docx", "txt", "md"] },
        "category": { "type": "string", "maxLength": 80 },
        "content": { "type": "string", "maxLength": 80000 },
        "summary": { "type": "string", "maxLength": 1000 },
        "tags": { "type": "array" },
        "wordCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "fileName", "fileType", "category", "content", "summary", "tags", "wordCount", "createdAt", "updatedAt"]
    },
    "Approval": {
      "title": "Approval",
      "description": "Human-in-the-loop authorization request for sensitive workflow actions.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "workflowId": { "type": "string", "maxLength": 128 },
        "workflowTitle": { "type": "string", "maxLength": 200 },
        "actionType": { "type": "string", "maxLength": 100 },
        "integrationTarget": { "type": "string", "maxLength": 100 },
        "isSimulated": { "type": "boolean" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
        "reason": { "type": "string", "maxLength": 1000 },
        "proposedPayload": { "type": "string", "maxLength": 4000 },
        "requestedBy": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "changes_requested"] },
        "reviewerNote": { "type": "string", "maxLength": 1000 },
        "reviewedBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "workflowId", "workflowTitle", "actionType", "integrationTarget", "isSimulated", "riskLevel", "reason", "proposedPayload", "requestedBy", "status", "createdAt", "updatedAt"]
    },
    "Integration": {
      "title": "Integration",
      "description": "Enterprise connector configuration with explicit simulated/live labeling.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "key": { "type": "string", "maxLength": 60 },
        "name": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "enum": ["email", "crm", "ticketing", "project_management", "calendar", "rest_api"] },
        "provider": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["connected_simulated", "connected_live", "disconnected", "error"] },
        "isSimulated": { "type": "boolean" },
        "endpointUrl": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 500 },
        "lastSyncAt": { "type": "string", "maxLength": 60 },
        "executionsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "key", "name", "category", "provider", "status", "isSimulated", "description", "executionsCount", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable workflow execution and authorization audit log entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "workflowId": { "type": "string", "maxLength": 128 },
        "workflowTitle": { "type": "string", "maxLength": 200 },
        "eventType": { "type": "string", "maxLength": 80 },
        "actor": { "type": "string", "maxLength": 120 },
        "summary": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["success", "pending", "failed", "warning"] },
        "isSimulated": { "type": "boolean" },
        "durationMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "workflowId", "workflowTitle", "eventType", "actor", "summary", "status", "isSimulated", "durationMs", "createdAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Organization team member and role assignment.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["Admin", "Approver", "Operator", "Viewer"] },
        "department": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["active", "invited"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "role", "department", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User workspace profiles and preferences."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only private PII subcollection."
    },
    "/workflows/{workflowId}": {
      "schema": { "$ref": "#/entities/Workflow" },
      "description": "Enterprise workflows created via voice, AI Command Center, or manual builder."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks linked to workflows via workflowId."
    },
    "/knowledgeDocs/{docId}": {
      "schema": { "$ref": "#/entities/KnowledgeDoc" },
      "description": "Enterprise documents for RAG semantic retrieval."
    },
    "/approvals/{approvalId}": {
      "schema": { "$ref": "#/entities/Approval" },
      "description": "Human-in-the-loop approval requests."
    },
    "/integrations/{integrationId}": {
      "schema": { "$ref": "#/entities/Integration" },
      "description": "Enterprise tool integration configurations."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only execution and security audit logs."
    },
    "/teamMembers/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Team members and RBAC roles."
    }
  }
}
