# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# DATABASE_URL: PostgreSQL connection string for production multi-tenant persistence.
# Example: postgresql://postgres:postgres@localhost:5432/flowstate
# When omitted in local development, FLOWSTATE uses an atomic file-backed store (data/flowstate-db.json).
DATABASE_URL=""

# AUTH_SECRET: HMAC signing secret for backend session tokens (auto-generated in dev if unset).
AUTH_SECRET=""

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"
